AGENTOS_IMAGE=swr.example.invalid/tidewise/agentos:example-commit-sha
AGENTOS_EXTERNAL_URL=https://tideai.tripwise.cn/agentos
AGENTOS_DATA_DIR=/opt/tidewise/agentos-uat/data

DB_HOST=rds.internal.example
DB_PASS=replace-with-agent-os-uat-database-password
DEEPSEEK_API_KEY=replace-with-uat-deepseek-key
DATA_SERVICE_TOKEN=replace-with-uat-data-service-token
EVENT_EXTRACTION_BATCH_SIZE=50
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-uat-neo4j-password
GRAPHITI_EMBEDDING_API_KEY=replace-with-uat-embedding-key
GRAPHITI_EMBEDDING_BASE_URL=https://embedding.example.invalid/compatible-mode/v1
GRAPHITI_EMBEDDING_MODEL=text-embedding-v4
GRAPHITI_EMBEDDING_DIM=1024
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=replace-with-uat-minio-access-key
MINIO_SECRET_KEY=replace-with-uat-minio-secret-key
RAW_EVIDENCE_BUCKET=raw-evidence
RAW_EVIDENCE_PUBLIC_BASE_URL=https://minio-uat.example.invalid
AGENTOS_JWKS_FILE=/opt/tidewise/agentos-uat/jwt-jwks.json
JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-control-plane-public-key\n-----END PUBLIC KEY-----"

MCP_CONNECT_SECRET=
AGENTOS_MCP_SIGNING_KEY=

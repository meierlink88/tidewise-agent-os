# DeepSeek V4 Flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Local default favors fast responses; set True when a task benefits from reasoning traces.
DEEPSEEK_USE_THINKING=False

# Raw collection Artifact volume and channel configuration.
# Host directory mounted at /app/data by Compose. Relative paths are project-relative.
COLLECTOR_DATA_DIR=./data
COLLECTOR_ARTIFACT_ROOT=/app/data/collector
COLLECTOR_MAX_QUERY_WINDOW_HOURS=8760
COLLECTOR_CONNECTOR_TIMEOUT_SECONDS=30

# API-key-backed search channels. Leave blank to disable that channel safely.
PARALLEL_API_KEY=
PARALLEL_SEARCH_BASE_URL=https://api.parallel.ai/v1/search
TAVILY_API_KEY=
TAVILY_SEARCH_BASE_URL=https://api.tavily.com/search
BOCHA_API_KEY=
BOCHA_SEARCH_BASE_URL=https://api.bochaai.com/v1/web-search

# Public professional-news channels.
CLS_TELEGRAPH_BASE_URL=https://www.cls.cn/v1/roll/get_roll_list
EASTMONEY_FAST_NEWS_BASE_URL=https://np-weblist.eastmoney.com/comm/web/getFastNewsList
EASTMONEY_STOCK_NEWS_BASE_URL=https://search-api-web.eastmoney.com/search/jsonp
STCN_QUICK_NEWS_BASE_URL=https://www.stcn.com/article/list.html

# Shared local PostgreSQL instance, isolated AgentOS database.
DB_HOST=postgres
DB_PORT=5432
DB_USER=agent_os_runtime
DB_PASS=replace-with-a-strong-password
DB_DATABASE=agent_os
DB_DRIVER=postgresql+psycopg

# Local scheduler/API origin.
AGENTOS_URL=http://127.0.0.1:8000
ENABLE_DEPLOY_CHECK=True

# Production-only security settings.
# JWT_VERIFICATION_KEY=
# JWT_JWKS_FILE=/app/jwks.json
# MCP_CONNECT_SECRET=
# AGENTOS_MCP_SIGNING_KEY=

# Optional Slack interface (both required to enable).
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=

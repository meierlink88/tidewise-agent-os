# DeepSeek V4 Flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Local default favors fast responses; set True when a task benefits from reasoning traces.
DEEPSEEK_USE_THINKING=False

# Raw collection Artifact volume and bounded execution configuration.
# Host directory mounted at /app/data by Compose. Relative paths are project-relative.
COLLECTOR_DATA_DIR=./data
COLLECTOR_ARTIFACT_ROOT=/app/data/collector
COLLECTOR_CHANNEL_CONCURRENCY=8

# AgentOS-owned MinIO stores immutable Raw Evidence Markdown. Data Service receives
# only /{bucket}/{object_key}; it never receives these credentials or the article body.
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
RAW_EVIDENCE_BUCKET=raw-evidence
RAW_EVIDENCE_PUBLIC_BASE_URL=http://127.0.0.1:9000

# Evidence extraction Artifacts and versioned Data Service API publication.
# UAT uses the Huawei Cloud public HTTPS API. MinIO is an AgentOS-owned dependency,
# not Data Service infrastructure.
EVIDENCE_ARTIFACT_ROOT=/app/data/evidence
DATA_SERVICE_BASE_URL=http://data:9011
DATA_SERVICE_TOKEN=

# Event extraction Artifacts. Event resolution, Graphiti projection, and Signal
# construction run inside AgentOS.
EVENT_ARTIFACT_ROOT=/app/data/event
EVENT_EXTRACTION_BATCH_SIZE=20

# Finalized Investment Conclusion Artifacts. Workflow audit records remain in Agno PostgreSQL.
INVESTMENT_ARTIFACT_ROOT=/app/data/investment

# Graphiti semantic graph and its Neo4j store. Graphiti receives the registered
# AgentOS DeepSeek model; only Neo4j and the embedding provider are configured here.
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
GRAPHITI_EMBEDDING_API_KEY=
GRAPHITI_EMBEDDING_BASE_URL=
GRAPHITI_EMBEDDING_MODEL=
GRAPHITI_EMBEDDING_DIM=1024

# Shared local PostgreSQL instance, isolated AgentOS database.
DB_HOST=postgres
DB_PORT=5432
DB_USER=agent_os_runtime
DB_PASS=replace-with-a-strong-password
DB_DATABASE=agent_os
DB_DRIVER=postgresql+psycopg
DB_SSLMODE=

# Local scheduler/API origin. ENABLE_DEPLOY_CHECK controls whether the explicit
# new-environment Schedule seed includes the deployment check.
AGENTOS_EXTERNAL_URL=http://127.0.0.1:8000
AGENTOS_INTERNAL_URL=http://127.0.0.1:8000
ENABLE_DEPLOY_CHECK=True

# Production-only security settings.
# JWT_VERIFICATION_KEY=
# JWT_JWKS_FILE=/app/jwks.json
# MCP_CONNECT_SECRET=
# AGENTOS_MCP_SIGNING_KEY=

# Optional Slack interface (both required to enable).
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
